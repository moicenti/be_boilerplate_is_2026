# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Zona horaria de los horarios de las áreas comunes (IANA).
APP_TIMEZONE=America/El_Salvador
# Espera simulada de la pasarela de pago de prueba (H1), en milisegundos.
PAGO_SIMULADO_ESPERA_MS=5000
# Proxies delante de la API, para que el rate limit vea la IP real del cliente.
# Local/Docker: 0. Render: 1.
TRUST_PROXY_HOPS=0
# Orígenes del frontend separados por coma, si vive en otro dominio
# (ej. http://localhost:5173,https://mi-front.onrender.com). Vacío = sin CORS.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# PostgreSQL (consumido por docker-compose para inicializar el contenedor)
# ---------------------------------------------------------------------------
# Obligatorias para docker-compose (no tienen default). Usá una contraseña propia.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiame-por-una-contrasena-segura
POSTGRES_DB=si_be_boilerplate
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Prisma
# Al correr la API en el host contra el Postgres de Docker, el host es localhost.
# Al correr la API dentro de docker-compose, docker-compose.yml sobreescribe
# esta variable para apuntar al servicio `postgres` en lugar de `localhost`.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:cambiame-por-una-contrasena-segura@localhost:5432/si_be_boilerplate?schema=public

# ---------------------------------------------------------------------------
# Autenticación
# Generá un secreto propio: openssl rand -base64 32
# ---------------------------------------------------------------------------
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# Seed (`npm run db:seed`)
# Contraseña de TODAS las cuentas demo, incluido admin@example.com.
# 12 a 72 caracteres, con minúscula, mayúscula y número. Sin ella el seed falla.
# ---------------------------------------------------------------------------
SEED_DEMO_PASSWORD=
