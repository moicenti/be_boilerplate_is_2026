// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider        = "prisma-client"
  previewFeatures = ["partialIndexes"]

  output = "../src/generated/prisma"

  engineType = "client"
  runtime    = "nodejs"

  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  unit          String

  role Role @default(RESIDENTE)

  reports Report[]

  receivedPackages  Package[] @relation("PackageReceivedBy")
  deliveredPackages Package[] @relation("PackageDeliveredBy")

  deletedCommonAreas CommonArea[]       @relation("CommonAreaDeletedBy")
  commonAreaChanges  CommonAreaChange[]
  commonAreaBlocks   CommonAreaBlock[]  @relation("CommonAreaBlockCreatedBy")
  reservations       Reservation[]

  comunicados         ComunicadoOficial[] @relation("ComunicadosEmitidos")
  lecturasComunicados LecturaComunicado[] @relation("LecturasResidente")

  preferenciasNotificacion PreferenciaNotificacion[]
  notificacionesRecibidas  Notificacion[]            @relation("NotificacionesRecibidas")
  lotesEmitidos            LoteNotificacion[]        @relation("LotesEmitidos")

  @@map("users")
}

enum Role {
  RESIDENTE
  ADMINISTRADOR
  SEGURIDAD
}

model Unit {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  tower       String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  packages       Package[]
  notificaciones Notificacion[]

  @@map("units")
}

enum PackageStatus {
  PENDIENTE_RETIRO
  ENTREGADO
}

model Package {
  id                String        @id @default(uuid()) @db.Uuid
  number            Int           @unique @default(autoincrement())
  folio             String        @unique
  recipientName     String        @map("recipient_name")
  carrier           String
  trackingReference String        @map("tracking_reference")
  description       String
  notes             String?
  pickupCode        String        @map("pickup_code") @db.Char(6)
  status            PackageStatus @default(PENDIENTE_RETIRO)

  unitId String @map("unit_id") @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  receivedById String   @map("received_by_id") @db.Uuid
  receivedBy   User     @relation("PackageReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedAt   DateTime @default(now()) @map("received_at")

  deliveredTo   String?   @map("delivered_to")
  deliveredById String?   @map("delivered_by_id") @db.Uuid
  deliveredBy   User?     @relation("PackageDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)
  deliveredAt   DateTime? @map("delivered_at")

  reminderSentAt DateTime? @map("reminder_sent_at")

  @@index([status, receivedAt])
  @@index([unitId])
  @@map("packages")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Report {
  id          String @id @default(uuid()) @db.Uuid
  folio       String @unique
  title       String
  description String
  category    String
  location    String
  status      String @default("Abierto")
  unit        String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relación con el usuario que crea el reporte
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relación con las fotos
  photos ReportPhoto[]

  @@map("reports")
}

model ReportPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  url       String // Ruta o URL del archivo guardado
  createdAt DateTime @default(now()) @map("created_at")

  // Relación con el reporte
  reportId String @map("report_id") @db.Uuid
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_photos")
}

// ───────────── H23: notificaciones ─────────────

enum EstadoNotificacion {
  PENDIENTE
  ENVIADA
  FALLIDO
  FALLIDO_PERMANENTE
}

model PreferenciaNotificacion {
  id           Int     @id @default(autoincrement())
  residenteId  String  @map("residente_id") @db.Uuid
  moduloOrigen String  @map("modulo_origen")
  activo       Boolean @default(true)

  residente User @relation(fields: [residenteId], references: [id], onDelete: Cascade)

  @@unique([residenteId, moduloOrigen])
  @@map("preferencia_notificacion")
}

model LoteNotificacion {
  id            Int      @id @default(autoincrement())
  moduloOrigen  String   @map("modulo_origen")
  emitidoPorId  String?  @map("emitido_por") @db.Uuid
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz

  emitidoPor     User?          @relation("LotesEmitidos", fields: [emitidoPorId], references: [id])
  notificaciones Notificacion[]

  @@map("lote_notificacion")
}

model Notificacion {
  id            Int                @id @default(autoincrement())
  loteId        Int                @map("lote_id")
  residenteId   String             @map("residente_id") @db.Uuid
  unidadId      String?            @map("unidad_id") @db.Uuid
  tipo          String
  titulo        String
  mensaje       String
  moduloOrigen  String             @map("modulo_origen")
  enlaceAccion  String?            @map("enlace_accion")
  leida         Boolean            @default(false)
  fechaLectura  DateTime?          @map("fecha_lectura") @db.Timestamptz
  forzada       Boolean            @default(false)
  estado        EstadoNotificacion @default(PENDIENTE)
  fechaCreacion DateTime           @default(now()) @map("fecha_creacion") @db.Timestamptz

  lote      LoteNotificacion @relation(fields: [loteId], references: [id])
  residente User             @relation("NotificacionesRecibidas", fields: [residenteId], references: [id])
  unidad    Unit?            @relation(fields: [unidadId], references: [id])
  intentos  IntentoEnvio[]

  @@index([estado])
  @@index([residenteId])
  @@map("notificacion")
}

model IntentoEnvio {
  id             Int      @id @default(autoincrement())
  notificacionId Int      @map("notificacion_id")
  numeroIntento  Int      @map("numero_intento")
  motivoFallo    String?  @map("motivo_fallo")
  fechaIntento   DateTime @default(now()) @map("fecha_intento") @db.Timestamptz

  notificacion Notificacion @relation(fields: [notificacionId], references: [id], onDelete: Cascade)

  @@unique([notificacionId, numeroIntento])
  @@index([notificacionId])
  @@map("intento_envio")
}

// ---------------------------------------------------------------------------
// H6. Áreas comunes
// Los nombres de tablas y columnas siguen el diseño técnico (DB-6.1).
// ---------------------------------------------------------------------------

enum CommonAreaStatus {
  ACTIVA
  ELIMINADA
}

model CommonArea {
  id                 Int              @id @default(autoincrement())
  name               String           @map("nombre")
  capacity           Int              @map("capacidad")
  location           String           @map("ubicacion")
  /// Duración en horas de cada bloque de reserva.
  blockDurationHours Int              @map("duracion_bloque_horas")
  usageConditions    String?          @map("condiciones_uso")
  status             CommonAreaStatus @default(ACTIVA) @map("estado")
  createdAt          DateTime         @default(now()) @map("creado_en") @db.Timestamptz(6)

  // Eliminación lógica: quién y cuándo.
  deletedAt   DateTime? @map("eliminado_en") @db.Timestamptz(6)
  deletedById String?   @map("eliminado_por") @db.Uuid
  deletedBy   User?     @relation("CommonAreaDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  schedules    CommonAreaSchedule[]
  blocks       CommonAreaBlock[]
  reservations Reservation[]
  changes      CommonAreaChange[]

  // El nombre es único solo entre áreas ACTIVAS: una eliminada libera su nombre.
  @@unique([name], map: "area_comun_nombre_activa_key", where: raw("estado = 'ACTIVA'"))
  @@map("area_comun")
}

model CommonAreaSchedule {
  id        Int        @id @default(autoincrement())
  areaId    Int        @map("area_id")
  area      CommonArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  dayOfWeek Int        @map("dia_semana") @db.SmallInt
  opensAt   DateTime   @map("hora_apertura") @db.Time(0)
  closesAt  DateTime   @map("hora_cierre") @db.Time(0)

  // Un horario por día.
  @@unique([areaId, dayOfWeek])
  @@map("horario_area")
}

enum CommonAreaBlockReason {
  MANTENIMIENTO
  RENOVACION
  OTRO
}

model CommonAreaBlock {
  id       Int                   @id @default(autoincrement())
  areaId   Int                   @map("area_id")
  area     CommonArea            @relation(fields: [areaId], references: [id], onDelete: Cascade)
  startsAt DateTime              @map("inicio") @db.Timestamptz(6)
  endsAt   DateTime              @map("fin") @db.Timestamptz(6)
  reason   CommonAreaBlockReason @map("motivo")

  createdAt   DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  createdById String?  @map("creado_por") @db.Uuid
  createdBy   User?    @relation("CommonAreaBlockCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([areaId, startsAt])
  @@map("bloqueo_area")
}

enum CommonAreaChangeField {
  CAPACIDAD
  HORARIOS
  DURACION_BLOQUE
}

/// Historial de cambios de capacidad, horario y duración de bloque de un área.
model CommonAreaChange {
  id            Int                   @id @default(autoincrement())
  areaId        Int                   @map("area_id")
  area          CommonArea            @relation(fields: [areaId], references: [id], onDelete: Cascade)
  field         CommonAreaChangeField @map("campo")
  previousValue Json                  @map("valor_anterior")
  newValue      Json                  @map("valor_nuevo")
  changedById   String?               @map("usuario_id") @db.Uuid
  changedBy     User?                 @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt     DateTime              @default(now()) @map("cambiado_en") @db.Timestamptz(6)

  @@index([areaId])
  @@map("historial_area")
}

enum ReservationStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

/// Modelo mínimo de reserva: H6 solo lo necesita para bloquear la eliminación
/// de áreas con reservas futuras. La historia de reservas lo completará.
model Reservation {
  id        Int               @id @default(autoincrement())
  areaId    Int               @map("area_id")
  // Restrict: las reservas se conservan aunque el área se elimine (lógicamente).
  area      CommonArea        @relation(fields: [areaId], references: [id], onDelete: Restrict)
  userId    String            @map("usuario_id") @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt  DateTime          @map("inicio") @db.Timestamptz(6)
  endsAt    DateTime          @map("fin") @db.Timestamptz(6)
  status    ReservationStatus @default(PENDIENTE) @map("estado")
  createdAt DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([areaId, startsAt])
  @@map("reserva")
}

enum CategoriaComunicado {
  MANTENIMIENTO
  SEGURIDAD
  ADMINISTRATIVO
}

enum PrioridadComunicado {
  INFORMATIVO
  IMPORTANTE
  URGENTE
}

enum AudienciaTipo {
  TODO_EL_CONDOMINIO
  POR_TORRE
  POR_SECCION
}

enum EstadoComunicado {
  PUBLICADO
}

// ==========================================
// MÓDULO 7: ANUNCIOS Y COMUNICADOS (H19 & H20)
// ==========================================

model ComunicadoOficial {
  id               Int                 @id @default(autoincrement())
  titulo           String              @db.VarChar(120)
  cuerpo           String              @db.VarChar(2000)
  categoria        CategoriaComunicado
  prioridad        PrioridadComunicado
  audienciaTipo    AudienciaTipo       @map("audiencia_tipo")
  audienciaTarget  String?             @map("audiencia_target") @db.VarChar(50)
  estado           EstadoComunicado    @default(PUBLICADO)
  fechaPublicacion DateTime            @default(now()) @map("fecha_publicacion") @db.Timestamptz

  // Llave foránea hacia el Administrador emisor (UUID)
  emisorId String @map("emisor_id") @db.Uuid
  emisor   User   @relation("ComunicadosEmitidos", fields: [emisorId], references: [id], onDelete: Restrict)

  // Adjuntos y lecturas
  adjuntos ComunicadoAdjunto[]
  lecturas LecturaComunicado[]

  @@map("comunicado_oficial")
}

model ComunicadoAdjunto {
  id             Int      @id @default(autoincrement())
  comunicadoId   Int      @map("comunicado_id")
  nombreOriginal String   @map("nombre_original") @db.VarChar(255)
  rutaArchivo    String   @map("ruta_archivo") @db.VarChar(500)
  tipoMime       String   @map("tipo_mime") @db.VarChar(50)
  tamanoBytes    Int      @map("tamano_bytes")
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz

  comunicado ComunicadoOficial @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)

  @@index([comunicadoId])
  @@map("comunicado_adjunto")
}

model LecturaComunicado {
  id           Int      @id @default(autoincrement())
  comunicadoId Int      @map("comunicado_id")
  residenteId  String   @map("residente_id") @db.Uuid
  fechaLectura DateTime @default(now()) @map("fecha_lectura") @db.Timestamptz

  comunicado ComunicadoOficial @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  residente  User              @relation("LecturasResidente", fields: [residenteId], references: [id], onDelete: Cascade)

  @@unique([comunicadoId, residenteId])
  @@map("lectura_comunicado")
}
