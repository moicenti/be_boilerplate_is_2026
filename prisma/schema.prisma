// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIADA
  FALLIDO
  FALLIDO_PERMANENTE
}

model PreferenciaNotificacion {
  id           Int     @id @default(autoincrement())
  residenteId  String  @map("residente_id") @db.Uuid
  moduloOrigen String  @map("modulo_origen")
  activo       Boolean @default(true)

  residente User @relation(fields: [residenteId], references: [id], onDelete: Cascade)

  @@unique([residenteId, moduloOrigen])
  @@map("preferencia_notificacion")
}

model LoteNotificacion {
  id            Int      @id @default(autoincrement())
  moduloOrigen  String   @map("modulo_origen")
  emitidoPorId  String?  @map("emitido_por") @db.Uuid
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz

  emitidoPor     User?          @relation("LotesEmitidos", fields: [emitidoPorId], references: [id])
  notificaciones Notificacion[]

  @@map("lote_notificacion")
}

model Notificacion {
  id            Int                @id @default(autoincrement())
  loteId        Int                @map("lote_id")
  residenteId   String             @map("residente_id") @db.Uuid
  unidadId      Int?               @map("unidad_id")
  tipo          String
  titulo        String
  mensaje       String
  moduloOrigen  String             @map("modulo_origen")
  enlaceAccion  String?            @map("enlace_accion")
  leida         Boolean            @default(false)
  fechaLectura  DateTime?          @map("fecha_lectura") @db.Timestamptz
  forzada       Boolean            @default(false)
  estado        EstadoNotificacion @default(PENDIENTE)
  fechaCreacion DateTime           @default(now()) @map("fecha_creacion") @db.Timestamptz

  lote      LoteNotificacion @relation(fields: [loteId], references: [id])
  residente User             @relation("NotificacionesRecibidas", fields: [residenteId], references: [id])
  unidad    Unit?            @relation(fields: [unidadId], references: [id])
  intentos  IntentoEnvio[]

  @@index([estado])
  @@index([residenteId])
  @@map("notificacion")
}

model IntentoEnvio {
  id             Int      @id @default(autoincrement())
  notificacionId Int      @map("notificacion_id")
  numeroIntento  Int      @map("numero_intento")
  motivoFallo    String?  @map("motivo_fallo")
  fechaIntento   DateTime @default(now()) @map("fecha_intento") @db.Timestamptz

  notificacion Notificacion @relation(fields: [notificacionId], references: [id], onDelete: Cascade)

  @@unique([notificacionId, numeroIntento])
  @@index([notificacionId])
  @@map("intento_envio")
}