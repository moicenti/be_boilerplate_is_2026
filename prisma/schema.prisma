// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  output = "../src/generated/prisma"

  engineType = "client"
  runtime    = "nodejs"

  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS DEL SISTEMA Y COMUNICADOS
// ==========================================

enum Rol {
  ADMINISTRADOR
  RESIDENTE
  SEGURIDAD
}

enum CategoriaComunicado {
  MANTENIMIENTO
  SEGURIDAD
  ADMINISTRATIVO
}

enum PrioridadComunicado {
  INFORMATIVO
  IMPORTANTE
  URGENTE
}

enum AudienciaTipo {
  TODO_EL_CONDOMINIO
  POR_TORRE
  POR_SECCION
}

enum EstadoComunicado {
  PUBLICADO
}

// ==========================================
// MÓDULO 0: USUARIOS Y AUTENTICACIÓN
// ==========================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  rol          Rol      @default(RESIDENTE)
  isActive     Boolean  @default(true) @map("is_active")
  unit         String?  @map("unit")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  reports             Report[]

  // Relaciones inversas del Módulo 7 (Comunicados y Cartelera)
  comunicados         ComunicadoOficial[]  @relation("ComunicadosEmitidos")
  lecturasComunicados LecturaComunicado[]  @relation("LecturasResidente")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ==========================================
// MÓDULO 3: INCIDENCIAS
// ==========================================

model Report {
  id          String        @id @default(uuid()) @db.Uuid
  folio       String        @unique
  title       String
  description String
  category    String
  location    String
  status      String        @default("Abierto")
  unit        String
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  userId      String        @map("user_id") @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos      ReportPhoto[]

  @@map("reports")
}

model ReportPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  reportId  String   @map("report_id") @db.Uuid
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_photos")
}

// ==========================================
// MÓDULO 7: ANUNCIOS Y COMUNICADOS (H19 & H20)
// ==========================================

model ComunicadoOficial {
  id               Int                 @id @default(autoincrement())
  titulo           String              @db.VarChar(120)
  cuerpo           String              @db.VarChar(2000)
  categoria        CategoriaComunicado
  prioridad        PrioridadComunicado
  audienciaTipo    AudienciaTipo       @map("audiencia_tipo")
  audienciaTarget  String?             @map("audiencia_target") @db.VarChar(50)
  estado           EstadoComunicado    @default(PUBLICADO)
  fechaPublicacion DateTime            @default(now()) @map("fecha_publicacion") @db.Timestamptz

  // Llave foránea hacia el Administrador emisor (UUID)
  emisorId         String              @map("emisor_id") @db.Uuid
  emisor           User                @relation("ComunicadosEmitidos", fields: [emisorId], references: [id], onDelete: Restrict)

  // Adjuntos y lecturas
  adjuntos         ComunicadoAdjunto[]
  lecturas         LecturaComunicado[]

  @@map("comunicado_oficial")
}

model ComunicadoAdjunto {
  id             Int               @id @default(autoincrement())
  comunicadoId   Int               @map("comunicado_id")
  nombreOriginal String            @map("nombre_original") @db.VarChar(255)
  rutaArchivo    String            @map("ruta_archivo") @db.VarChar(500)
  tipoMime       String            @map("tipo_mime") @db.VarChar(50)
  tamanoBytes    Int               @map("tamano_bytes")
  creadoEn       DateTime          @default(now()) @map("creado_en") @db.Timestamptz

  comunicado     ComunicadoOficial @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)

  @@index([comunicadoId])
  @@map("comunicado_adjunto")
}

model LecturaComunicado {
  id           Int               @id @default(autoincrement())
  comunicadoId Int               @map("comunicado_id")
  residenteId  String            @map("residente_id") @db.Uuid
  fechaLectura DateTime          @default(now()) @map("fecha_lectura") @db.Timestamptz

  comunicado   ComunicadoOficial @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  residente    User              @relation("LecturasResidente", fields: [residenteId], references: [id], onDelete: Cascade)

  @@unique([comunicadoId, residenteId])
  @@map("lectura_comunicado")
}