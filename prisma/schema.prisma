// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider        = "prisma-client"
  previewFeatures = ["partialIndexes"]

  output = "../src/generated/prisma"

  engineType = "client"
  runtime    = "nodejs"

  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  unit          String
  role          Role           @default(RESIDENTE)

  reports Report[]

  deletedCommonAreas CommonArea[]       @relation("CommonAreaDeletedBy")
  commonAreaChanges  CommonAreaChange[]
  reservations       Reservation[]

  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Report {
  id          String @id @default(uuid()) @db.Uuid
  folio       String @unique
  title       String
  description String
  category    String
  location    String
  status      String @default("Abierto")
  unit        String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relación con el usuario que crea el reporte
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relación con las fotos
  photos ReportPhoto[]

  @@map("reports")
}

model ReportPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  url       String // Ruta o URL del archivo guardado
  createdAt DateTime @default(now()) @map("created_at")

  // Relación con el reporte
  reportId String @map("report_id") @db.Uuid
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_photos")
}

enum Role {
  ADMINISTRADOR
  RESIDENTE
}

// ---------------------------------------------------------------------------
// H6. Áreas comunes
// Los nombres de tablas y columnas siguen el diseño técnico (DB-6.1).
// ---------------------------------------------------------------------------

enum CommonAreaStatus {
  ACTIVA
  ELIMINADA
}

model CommonArea {
  id        Int              @id @default(autoincrement())
  name      String           @map("nombre")
  capacity  Int              @map("capacidad")
  status    CommonAreaStatus @default(ACTIVA) @map("estado")
  createdAt DateTime         @default(now()) @map("creado_en") @db.Timestamptz(6)

  // Eliminación lógica: quién y cuándo.
  deletedAt   DateTime? @map("eliminado_en") @db.Timestamptz(6)
  deletedById String?   @map("eliminado_por") @db.Uuid
  deletedBy   User?     @relation("CommonAreaDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  schedules    CommonAreaSchedule[]
  blocks       CommonAreaBlock[]
  reservations Reservation[]
  changes      CommonAreaChange[]

  // El nombre es único solo entre áreas ACTIVAS: una eliminada libera su nombre.
  @@unique([name], map: "area_comun_nombre_activa_key", where: raw("estado = 'ACTIVA'"))
  @@map("area_comun")
}

model CommonAreaSchedule {
  id        Int        @id @default(autoincrement())
  areaId    Int        @map("area_id")
  area      CommonArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  dayOfWeek Int        @map("dia_semana") @db.SmallInt
  opensAt   DateTime   @map("hora_apertura") @db.Time(0)
  closesAt  DateTime   @map("hora_cierre") @db.Time(0)

  // Un horario por día.
  @@unique([areaId, dayOfWeek])
  @@map("horario_area")
}

enum CommonAreaBlockReason {
  MANTENIMIENTO
  RENOVACION
  OTRO
}

model CommonAreaBlock {
  id       Int                   @id @default(autoincrement())
  areaId   Int                   @map("area_id")
  area     CommonArea            @relation(fields: [areaId], references: [id], onDelete: Cascade)
  startsAt DateTime              @map("inicio") @db.Timestamptz(6)
  endsAt   DateTime              @map("fin") @db.Timestamptz(6)
  reason   CommonAreaBlockReason @map("motivo")

  @@index([areaId])
  @@map("bloqueo_area")
}

enum CommonAreaChangeField {
  CAPACIDAD
  HORARIOS
}

/// Historial de cambios de capacidad y horario de un área.
model CommonAreaChange {
  id            Int                   @id @default(autoincrement())
  areaId        Int                   @map("area_id")
  area          CommonArea            @relation(fields: [areaId], references: [id], onDelete: Cascade)
  field         CommonAreaChangeField @map("campo")
  previousValue Json                  @map("valor_anterior")
  newValue      Json                  @map("valor_nuevo")
  changedById   String?               @map("usuario_id") @db.Uuid
  changedBy     User?                 @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt     DateTime              @default(now()) @map("cambiado_en") @db.Timestamptz(6)

  @@index([areaId])
  @@map("historial_area")
}

enum ReservationStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

/// Modelo mínimo de reserva: H6 solo lo necesita para bloquear la eliminación
/// de áreas con reservas futuras. La historia de reservas lo completará.
model Reservation {
  id        Int               @id @default(autoincrement())
  areaId    Int               @map("area_id")
  // Restrict: las reservas se conservan aunque el área se elimine (lógicamente).
  area      CommonArea        @relation(fields: [areaId], references: [id], onDelete: Restrict)
  userId    String            @map("usuario_id") @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt  DateTime          @map("inicio") @db.Timestamptz(6)
  endsAt    DateTime          @map("fin") @db.Timestamptz(6)
  status    ReservationStatus @default(PENDIENTE) @map("estado")
  createdAt DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([areaId, startsAt])
  @@map("reserva")
}
