// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider        = "prisma-client"
  previewFeatures = ["partialIndexes"]

  output = "../src/generated/prisma"

  engineType = "client"
  runtime    = "nodejs"

  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  unitId        String?        @map("unit_id") @db.Uuid
  unit          Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)

  role Role @default(RESIDENTE)

  reports         Report[]      @relation("UserReports")
  assignedReports Report[]      @relation("AssignedReports")
  resolvedReports Report[]      @relation("ResolvedReports")
  events          ReportEvent[]

  receivedPackages  Package[] @relation("PackageReceivedBy")
  deliveredPackages Package[] @relation("PackageDeliveredBy")

  deletedCommonAreas CommonArea[]       @relation("CommonAreaDeletedBy")
  commonAreaChanges  CommonAreaChange[]
  commonAreaBlocks   CommonAreaBlock[]  @relation("CommonAreaBlockCreatedBy")
  reservations       Reservation[]
  feeRulesCreated    FeeRule[]          @relation("FeeRuleCreatedBy")
  feeRuleChanges     FeeRuleChange[]
  generationRuns     GenerationRun[]

  comunicados         ComunicadoOficial[] @relation("ComunicadosEmitidos")
  lecturasComunicados LecturaComunicado[] @relation("LecturasResidente")

  preferenciasNotificacion PreferenciaNotificacion[]
  notificacionesRecibidas  Notificacion[]            @relation("NotificacionesRecibidas")
  lotesEmitidos            LoteNotificacion[]        @relation("LotesEmitidos")

  @@map("users")
}

enum Role {
  RESIDENTE
  ADMINISTRADOR
  SEGURIDAD
  MANTENIMIENTO
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

model Unit {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  tower       String
  description String
  type        UnitType @default(DEPARTAMENTO) @map("tipo")
  // Una unidad inactiva solo recibe cuotas automáticas según la política de cada regla.
  active      Boolean  @default(true) @map("activa")
  createdAt   DateTime @default(now()) @map("created_at")

  users            User[]
  packages         Package[]
  notificaciones   Notificacion[]
  reservations     Reservation[]
  fees             Fee[]
  feeRules         FeeRuleUnit[]
  generationErrors GenerationError[]

  @@map("units")
}

enum UnitType {
  DEPARTAMENTO
  CASA
  LOCAL
}

enum PackageStatus {
  PENDIENTE_RETIRO
  ENTREGADO
}

model Package {
  id                String        @id @default(uuid()) @db.Uuid
  number            Int           @unique @default(autoincrement())
  folio             String        @unique
  recipientName     String        @map("recipient_name")
  carrier           String
  trackingReference String        @map("tracking_reference")
  description       String
  notes             String?
  pickupCode        String        @map("pickup_code") @db.Char(6)
  status            PackageStatus @default(PENDIENTE_RETIRO)

  unitId String @map("unit_id") @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  receivedById String   @map("received_by_id") @db.Uuid
  receivedBy   User     @relation("PackageReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedAt   DateTime @default(now()) @map("received_at")

  deliveredTo   String?   @map("delivered_to")
  deliveredById String?   @map("delivered_by_id") @db.Uuid
  deliveredBy   User?     @relation("PackageDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)
  deliveredAt   DateTime? @map("delivered_at")

  reminderSentAt DateTime? @map("reminder_sent_at")

  @@index([status, receivedAt])
  @@index([unitId])
  @@map("packages")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Report {
  id          String @id @default(uuid()) @db.Uuid
  folio       String @unique
  title       String
  description String
  category    String
  location    String
  status      String @default("Abierto")
  unit        String

  priority              Priority?
  priorityJustification String?   @map("priority_justification")
  assigneeId            String?   @map("assignee_id") @db.Uuid
  dueDate               DateTime? @map("due_date")

  resolvedAt        DateTime? @map("resolved_at")
  resolvedById      String?   @map("resolved_by_id") @db.Uuid
  resolutionComment String?   @map("resolution_comment")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id") @db.Uuid
  user   User   @relation("UserReports", fields: [userId], references: [id], onDelete: Cascade)

  assignee   User? @relation("AssignedReports", fields: [assigneeId], references: [id])
  resolvedBy User? @relation("ResolvedReports", fields: [resolvedById], references: [id])

  photos ReportPhoto[]
  events ReportEvent[]

  @@map("reports")
}

model ReportPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  reportId String @map("report_id") @db.Uuid
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_photos")
}

model ReportEvent {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  metadata  Json?
  userId    String   @map("user_id") @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_events")
}

// ───────────── H23: notificaciones ─────────────

enum EstadoNotificacion {
  PENDIENTE
  ENVIADA
  FALLIDO
  FALLIDO_PERMANENTE
}

model PreferenciaNotificacion {
  id           Int     @id @default(autoincrement())
  residenteId  String  @map("residente_id") @db.Uuid
  moduloOrigen String  @map("modulo_origen")
  activo       Boolean @default(true)

  residente User @relation(fields: [residenteId], references: [id], onDelete: Cascade)

  @@unique([residenteId, moduloOrigen])
  @@map("preferencia_notificacion")
}

model LoteNotificacion {
  id            Int      @id @default(autoincrement())
  moduloOrigen  String   @map("modulo_origen")
  emitidoPorId  String?  @map("emitido_por") @db.Uuid
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz

  emitidoPor     User?          @relation("LotesEmitidos", fields: [emitidoPorId], references: [id])
  notificaciones Notificacion[]

  @@map("lote_notificacion")
}

model Notificacion {
  id            Int                @id @default(autoincrement())
  loteId        Int                @map("lote_id")
  residenteId   String             @map("residente_id") @db.Uuid
  unidadId      String?            @map("unidad_id") @db.Uuid
  tipo          String
  titulo        String
  mensaje       String
  moduloOrigen  String             @map("modulo_origen")
  enlaceAccion  String?            @map("enlace_accion")
  leida         Boolean            @default(false)
  fechaLectura  DateTime?          @map("fecha_lectura") @db.Timestamptz
  forzada       Boolean            @default(false)
  estado        EstadoNotificacion @default(PENDIENTE)
  fechaCreacion DateTime           @default(now()) @map("fecha_creacion") @db.Timestamptz

  lote      LoteNotificacion @relation(fields: [loteId], references: [id])
  residente User             @relation("NotificacionesRecibidas", fields: [residenteId], references: [id])
  unidad    Unit?            @relation(fields: [unidadId], references: [id])
  intentos  IntentoEnvio[]

  @@index([estado])
  @@index([residenteId])
  @@map("notificacion")
}

model IntentoEnvio {
  id             Int      @id @default(autoincrement())
  notificacionId Int      @map("notificacion_id")
  numeroIntento  Int      @map("numero_intento")
  motivoFallo    String?  @map("motivo_fallo")
  fechaIntento   DateTime @default(now()) @map("fecha_intento") @db.Timestamptz

  notificacion Notificacion @relation(fields: [notificacionId], references: [id], onDelete: Cascade)

  @@unique([notificacionId, numeroIntento])
  @@index([notificacionId])
  @@map("intento_envio")
}

// ---------------------------------------------------------------------------
// H6. Áreas comunes
// Los nombres de tablas y columnas siguen el diseño técnico (DB-6.1).
// ---------------------------------------------------------------------------

enum CommonAreaStatus {
  ACTIVA
  ELIMINADA
}

model CommonArea {
  id                 Int              @id @default(autoincrement())
  name               String           @map("nombre")
  capacity           Int              @map("capacidad")
  location           String           @map("ubicacion")
  /// Duración en horas de cada bloque de reserva.
  blockDurationHours Int              @map("duracion_bloque_horas")
  usageConditions    String?          @map("condiciones_uso")
  status             CommonAreaStatus @default(ACTIVA) @map("estado")
  createdAt          DateTime         @default(now()) @map("creado_en") @db.Timestamptz(6)

  deletedAt   DateTime? @map("eliminado_en") @db.Timestamptz(6)
  deletedById String?   @map("eliminado_por") @db.Uuid
  deletedBy   User?     @relation("CommonAreaDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  schedules    CommonAreaSchedule[]
  blocks       CommonAreaBlock[]
  reservations Reservation[]
  changes      CommonAreaChange[]

  @@unique([name], map: "area_comun_nombre_activa_key", where: raw("estado = 'ACTIVA'"))
  @@map("area_comun")
}

model CommonAreaSchedule {
  id        Int        @id @default(autoincrement())
  areaId    Int        @map("area_id")
  area      CommonArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  dayOfWeek Int        @map("dia_semana") @db.SmallInt
  opensAt   DateTime   @map("hora_apertura") @db.Time(0)
  closesAt  DateTime   @map("hora_cierre") @db.Time(0)

  @@unique([areaId, dayOfWeek])
  @@map("horario_area")
}

enum CommonAreaBlockReason {
  MANTENIMIENTO
  RENOVACION
  OTRO
}

model CommonAreaBlock {
  id       Int                   @id @default(autoincrement())
  areaId   Int                   @map("area_id")
  area     CommonArea            @relation(fields: [areaId], references: [id], onDelete: Cascade)
  startsAt DateTime              @map("inicio") @db.Timestamptz(6)
  endsAt   DateTime              @map("fin") @db.Timestamptz(6)
  reason   CommonAreaBlockReason @map("motivo")

  createdAt   DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  createdById String?  @map("creado_por") @db.Uuid
  createdBy   User?    @relation("CommonAreaBlockCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([areaId, startsAt])
  @@map("bloqueo_area")
}

enum CommonAreaChangeField {
  CAPACIDAD
  HORARIOS
  DURACION_BLOQUE
}

model CommonAreaChange {
  id            Int                   @id @default(autoincrement())
  areaId        Int                   @map("area_id")
  area          CommonArea            @relation(fields: [areaId], references: [id], onDelete: Cascade)
  field         CommonAreaChangeField @map("campo")
  previousValue Json                  @map("valor_anterior")
  newValue      Json                  @map("valor_nuevo")
  changedById   String?               @map("usuario_id") @db.Uuid
  changedBy     User?                 @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt     DateTime              @default(now()) @map("cambiado_en") @db.Timestamptz(6)

  @@index([areaId])
  @@map("historial_area")
}

enum ReservationStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

model Reservation {
  id         Int               @id @default(autoincrement())
  areaId     Int               @map("area_id")
  // Restrict: las reservas se conservan aunque el área se elimine (lógicamente).
  area       CommonArea        @relation(fields: [areaId], references: [id], onDelete: Restrict)
  residentId String            @map("residente_id") @db.Uuid
  resident   User              @relation(fields: [residentId], references: [id], onDelete: Cascade)
  unitId     String            @map("unidad_id") @db.Uuid
  unit       Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  startsAt   DateTime          @map("inicio") @db.Timestamptz(6)
  endsAt     DateTime          @map("fin") @db.Timestamptz(6)
  status     ReservationStatus @default(CONFIRMADA) @map("estado")
  createdAt  DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)

  // La exclusión de cruces entre CONFIRMADAS vive en la migración (EXCLUDE USING gist).
  @@index([areaId, startsAt])
  @@index([residentId, startsAt])
  @@map("reserva")
}

enum CategoriaComunicado {
  MANTENIMIENTO
  SEGURIDAD
  ADMINISTRATIVO
}

enum PrioridadComunicado {
  INFORMATIVO
  IMPORTANTE
  URGENTE
}

enum AudienciaTipo {
  TODO_EL_CONDOMINIO
  POR_TORRE
  POR_SECCION
}

enum EstadoComunicado {
  PUBLICADO
}

// ==========================================
// MÓDULO 7: ANUNCIOS Y COMUNICADOS (H19 & H20)
// ==========================================

model ComunicadoOficial {
  id               Int                 @id @default(autoincrement())
  titulo           String              @db.VarChar(120)
  cuerpo           String              @db.VarChar(2000)
  categoria        CategoriaComunicado
  prioridad        PrioridadComunicado
  audienciaTipo    AudienciaTipo       @map("audiencia_tipo")
  audienciaTarget  String?             @map("audiencia_target") @db.VarChar(50)
  estado           EstadoComunicado    @default(PUBLICADO)
  fechaPublicacion DateTime            @default(now()) @map("fecha_publicacion") @db.Timestamptz

  emisorId String @map("emisor_id") @db.Uuid
  emisor   User   @relation("ComunicadosEmitidos", fields: [emisorId], references: [id], onDelete: Restrict)

  adjuntos ComunicadoAdjunto[]
  lecturas LecturaComunicado[]

  @@map("comunicado_oficial")
}

model ComunicadoAdjunto {
  id             Int      @id @default(autoincrement())
  comunicadoId   Int      @map("comunicado_id")
  nombreOriginal String   @map("nombre_original") @db.VarChar(255)
  rutaArchivo    String   @map("ruta_archivo") @db.VarChar(500)
  tipoMime       String   @map("tipo_mime") @db.VarChar(50)
  tamanoBytes    Int      @map("tamano_bytes")
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz

  comunicado ComunicadoOficial @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)

  @@index([comunicadoId])
  @@map("comunicado_adjunto")
}

model LecturaComunicado {
  id           Int      @id @default(autoincrement())
  comunicadoId Int      @map("comunicado_id")
  residenteId  String   @map("residente_id") @db.Uuid
  fechaLectura DateTime @default(now()) @map("fecha_lectura") @db.Timestamptz

  comunicado ComunicadoOficial @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  residente  User              @relation("LecturasResidente", fields: [residenteId], references: [id], onDelete: Cascade)

  @@unique([comunicadoId, residenteId])
  @@map("lectura_comunicado")
}

// ==========================================
// Cuotas (DB-1.1) y reglas de generación (H3)
// ==========================================

enum FeeStatus {
  PENDIENTE
  PARCIAL
  PAGADA
  ANULADA
}

/// Cuota de una unidad. La tabla de pagos llega con H1; el saldo no se almacena.
model Fee {
  id        Int       @id @default(autoincrement())
  unitId    String    @map("unidad_id") @db.Uuid
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  // Nula para cuotas creadas a mano. Restrict: una regla con cuotas no se elimina.
  ruleId    Int?      @map("regla_id")
  rule      FeeRule?  @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  concept   String    @map("concepto")
  period    String    @map("periodo") @db.Char(7)
  amount    Decimal   @map("monto") @db.Decimal(12, 2)
  dueDate   DateTime  @map("fecha_vencimiento") @db.Date
  status    FeeStatus @default(PENDIENTE) @map("estado")
  createdAt DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@unique([unitId, ruleId, period], map: "cuota_unidad_regla_periodo_key")
  @@index([unitId, status])
  @@index([status, dueDate])
  @@map("cuota")
}

enum FeeAmountType {
  FIJO
  POR_TIPO_UNIDAD
}

enum FeeRuleScope {
  TODAS
  TIPO
  TORRE
  SELECCION
}

enum InactiveUnitPolicy {
  GENERAR
  OMITIR
  REVISAR
}

enum FeeRuleStatus {
  ACTIVA
  PAUSADA
  INACTIVA
}

model FeeRule {
  id             Int                @id @default(autoincrement())
  concept        String             @map("concepto")
  amountType     FeeAmountType      @map("tipo_monto")
  // Nulo mientras la regla está incompleta (no se puede activar así).
  amount         Decimal?           @map("monto") @db.Decimal(12, 2)
  generationDay  Int                @map("dia_generacion") @db.SmallInt
  dueDay         Int                @map("dia_vencimiento") @db.SmallInt
  scope          FeeRuleScope       @map("alcance")
  // Torre (alcance TORRE) o tipo de unidad (alcance TIPO).
  scopeValue     String?            @map("alcance_valor")
  inactivePolicy InactiveUnitPolicy @default(OMITIR) @map("politica_inactivas")
  status         FeeRuleStatus      @default(ACTIVA) @map("estado")
  createdById    String?            @map("creado_por") @db.Uuid
  createdBy      User?              @relation("FeeRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  units       FeeRuleUnit[]
  typeAmounts FeeRuleTypeAmount[]
  fees        Fee[]
  runs        GenerationRun[]
  changes     FeeRuleChange[]

  @@index([status, generationDay])
  @@map("regla_cuota")
}

/// Unidades de una regla con alcance SELECCION.
model FeeRuleUnit {
  ruleId Int     @map("regla_id")
  rule   FeeRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  unitId String  @map("unidad_id") @db.Uuid
  unit   Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@id([ruleId, unitId])
  @@map("regla_cuota_unidad")
}

/// Monto por tipo de unidad de una regla POR_TIPO_UNIDAD.
model FeeRuleTypeAmount {
  ruleId   Int      @map("regla_id")
  rule     FeeRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  unitType UnitType @map("tipo_unidad")
  amount   Decimal  @map("monto") @db.Decimal(12, 2)

  @@id([ruleId, unitType])
  @@map("regla_cuota_monto_tipo")
}

enum FeeRuleAction {
  CREACION
  EDICION
  CAMBIO_ESTADO
}

/// Auditoría de reglas: quién cambió qué y cuándo.
model FeeRuleChange {
  id            Int           @id @default(autoincrement())
  ruleId        Int           @map("regla_id")
  rule          FeeRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  action        FeeRuleAction @map("accion")
  previousValue Json?         @map("valor_anterior")
  newValue      Json          @map("valor_nuevo")
  changedById   String?       @map("usuario_id") @db.Uuid
  changedBy     User?         @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt     DateTime      @default(now()) @map("cambiado_en") @db.Timestamptz(6)

  @@index([ruleId])
  @@map("regla_cuota_historial")
}

enum GenerationOrigin {
  AUTOMATICA
  MANUAL
}

enum GenerationRunStatus {
  EN_CURSO
  COMPLETADA
  CON_ERRORES
}

model GenerationRun {
  id         Int                 @id @default(autoincrement())
  ruleId     Int                 @map("regla_id")
  rule       FeeRule             @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  period     String              @map("periodo") @db.Char(7)
  origin     GenerationOrigin    @map("origen")
  // Nulo si es automática.
  userId     String?             @map("usuario_id") @db.Uuid
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  startedAt  DateTime            @default(now()) @map("inicio") @db.Timestamptz(6)
  finishedAt DateTime?           @map("fin") @db.Timestamptz(6)
  created    Int                 @default(0) @map("creadas")
  omitted    Int                 @default(0) @map("omitidas")
  failed     Int                 @default(0) @map("con_error")
  status     GenerationRunStatus @default(EN_CURSO) @map("estado")

  errors GenerationError[]

  // Nunca dos ejecuciones en curso para la misma regla y periodo.
  @@unique([ruleId, period], map: "ejecucion_generacion_en_curso_key", where: raw("estado = 'EN_CURSO'"))
  @@index([ruleId, period])
  @@map("ejecucion_generacion")
}

model GenerationError {
  id     Int           @id @default(autoincrement())
  runId  Int           @map("ejecucion_id")
  run    GenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  unitId String        @map("unidad_id") @db.Uuid
  unit   Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  cause  String        @map("causa")

  @@index([runId])
  @@map("ejecucion_error")
}
