// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  output = "../src/generated/prisma"

  engineType = "client"
  runtime    = "nodejs"

  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  unit         String

  reports       Report[]

  role Role @default(RESIDENTE)

  receivedPackages  Package[] @relation("PackageReceivedBy")
  deliveredPackages Package[] @relation("PackageDeliveredBy")

  @@map("users")
}

enum Role {
  RESIDENTE
  ADMINISTRADOR
  SEGURIDAD
}

model Unit {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  tower       String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  packages Package[]

  @@map("units")
}

enum PackageStatus {
  PENDIENTE_RETIRO
  ENTREGADO
}

model Package {
  id                String        @id @default(uuid()) @db.Uuid
  number            Int           @unique @default(autoincrement())
  folio             String        @unique
  recipientName     String        @map("recipient_name")
  carrier           String
  trackingReference String        @map("tracking_reference")
  description       String
  notes             String?
  pickupCode        String        @map("pickup_code") @db.Char(6)
  status            PackageStatus @default(PENDIENTE_RETIRO)

  unitId String @map("unit_id") @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  receivedById String   @map("received_by_id") @db.Uuid
  receivedBy   User     @relation("PackageReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedAt   DateTime @default(now()) @map("received_at")

  deliveredTo   String?   @map("delivered_to")
  deliveredById String?   @map("delivered_by_id") @db.Uuid
  deliveredBy   User?     @relation("PackageDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)
  deliveredAt   DateTime? @map("delivered_at")

  reminderSentAt DateTime? @map("reminder_sent_at")

  @@index([status, receivedAt])
  @@index([unitId])
  @@map("packages")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}



model Report {
  id          String   @id @default(uuid()) @db.Uuid
  folio       String   @unique
  title       String
  description String
  category    String
  location    String
  status      String   @default("Abierto")
  unit       String
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relación con el usuario que crea el reporte
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relación con las fotos
  photos      ReportPhoto[]

  @@map("reports")
}

model ReportPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  url       String   // Ruta o URL del archivo guardado
  createdAt DateTime @default(now()) @map("created_at")

  // Relación con el reporte
  reportId  String   @map("report_id") @db.Uuid
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_photos")
}