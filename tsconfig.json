{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    "baseUrl": "./src",
    "paths": {
      "@Auth": ["./src/auth/index.ts"],
      "@Auth/*": ["./src/auth/*/index.ts"],
      "@Users": ["./src/users/index.ts"],
      "@Users/*": ["./src/users/*/index.ts"],
      "@Health": ["./src/health/index.ts"],
      "@Health/*": ["./src/health/*/index.ts"],
      "@Prisma": ["./src/prisma/index.ts"],
      "@Prisma/*": ["./src/prisma/*/index.ts"],
      "@PrismaClient": ["./src/generated/prisma/client.ts"],
      "@Config": ["./src/config/index.ts"],
      "@Common/*": ["./src/common/*/index.ts"],
      "@Unidades": ["./src/unidades/index.ts"],
      "@Unidades/*": ["./src/unidades/*/index.ts"],
      "@Paquetes": ["./src/paquetes/index.ts"],
      "@Paquetes/*": ["./src/paquetes/*/index.ts"],
      "@Asambleas": ["./src/asambleas/index.ts"],
      "@Asambleas/*": ["./src/asambleas/*/index.ts"],
      "@Incidencias": ["./src/incidencias/index.ts"],
      "@Incidencias/*": ["./src/incidencias/*/index.ts"],
      "@CommonAreas": ["./src/common-areas/index.ts"],
      "@CommonAreas/*": ["./src/common-areas/*/index.ts"],
      "@Notificaciones": ["./src/notificaciones/index.ts"],
      "@Notificaciones/*": ["./src/notificaciones/*/index.ts"],
      "@Reportes": ["./src/reportes/index.ts"],
      "@Reportes/*": ["./src/reportes/*/index.ts"],
      "@Visitas": ["./src/visitas/index.ts"],
      "@Visitas/*": ["./src/visitas/*/index.ts"],
      "@Reservas": ["./src/reservas/index.ts"],
      "@Reservas/*": ["./src/reservas/*/index.ts"],
      "@Cuotas": ["./src/cuotas/index.ts"],
      "@Cuotas/*": ["./src/cuotas/*/index.ts"],
      "@Anuncio": ["./src/anuncio/index.ts"],
      "@Anuncio/*": ["./src/anuncio/*/index.ts"],
      "@Pagos": ["./src/pagos/index.ts"],
      "@Pagos/*": ["./src/pagos/*/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
