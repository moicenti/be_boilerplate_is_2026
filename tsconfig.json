{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    "baseUrl": "./src",
    "paths": {
      "@Auth": ["./auth/index.ts"],
      "@Auth/*": ["./auth/*"],
      "@Users": ["./users/index.ts"],
      "@Users/*": ["./users/*"],
      "@Health": ["./health/index.ts"],
      "@Health/*": ["./health/*"],
      "@Prisma": ["./prisma/index.ts"],
      "@Prisma/*": ["./prisma/*"],
      "@PrismaClient": ["./generated/prisma/client.ts"],
      "@Config": ["./config/index.ts"],
      "@Config/*": ["./config/*"],
      "@Common/*": ["./common/*"],
      "@Unidades": ["./unidades/index.ts"],
      "@Unidades/*": ["./unidades/*"],
      "@Paquetes": ["./paquetes/index.ts"],
      "@Paquetes/*": ["./paquetes/*"],
      "@Asambleas": ["./asambleas/index.ts"],
      "@Asambleas/*": ["./asambleas/*"],
      "@Incidencias": ["./incidencias/index.ts"],
      "@Incidencias/*": ["./incidencias/*"],
      "@CommonAreas": ["./common-areas/index.ts"],
      "@CommonAreas/*": ["./common-areas/*"],
      "@Notificaciones": ["./notificaciones/index.ts"],
      "@Notificaciones/*": ["./notificaciones/*"],
      "@Reportes": ["./reportes/index.ts"],
      "@Reportes/*": ["./reportes/*"],
      "@Visitas": ["./visitas/index.ts"],
      "@Visitas/*": ["./visitas/*"],
      "@Reservas": ["./reservas/index.ts"],
      "@Reservas/*": ["./reservas/*"],
      "@Cuotas": ["./cuotas/index.ts"],
      "@Cuotas/*": ["./cuotas/*"],
      "@Anuncio": ["./anuncio/index.ts"],
      "@Anuncio/*": ["./anuncio/*"],
      "@Pagos": ["./pagos/index.ts"],
      "@Pagos/*": ["./pagos/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
